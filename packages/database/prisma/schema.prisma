generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  DRIVER
}

enum TripStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TripSource {
  /// Horario fijo cargado por el admin: elegible para compartido
  SCHEDULED
  /// Creado al vuelo para un privado a hora libre: no debe listarse
  /// como opcion de compartido, es un vehiculo exclusivo de esa reserva
  ON_DEMAND
}

enum BookingType {
  SHARED
  PRIVATE
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum LegDirection {
  OUTBOUND
  RETURN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  phone        String?
  password     String        @default("")
  role         Role          @default(CUSTOMER)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Route {
  id           String   @id @default(uuid())
  slug         String   @unique
  origin       String
  destination  String
  durationMin  Int
  distanceKm   Int
  imageUrl     String?
  /// Privado va en un vehiculo exclusivo a la hora que el cliente elija, asi
  /// que no tiene sentido por Trip: es un precio fijo por ruta.
  pricePrivate Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  trips        Trip[]
  schedules    RouteSchedule[]
  createdAt    DateTime @default(now())
}

model RouteSchedule {
  id      String @id @default(uuid())
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String

  /// Hora de salida en hora local de Costa Rica, formato "HH:MM" de 24h.
  ///
  /// Se guarda como texto y NO como DateTime a proposito: una plantilla no es
  /// un instante, es "todos los dias a las 8". Guardar un DateTime obliga a
  /// elegir un dia cualquiera como portador de la hora, que es justo de donde
  /// salio el bug de los viajes a las 3am. La conversion a UTC la hace el
  /// generador, usando que Costa Rica es UTC-6 fijo (no tiene horario de verano).
  departureTime String

  priceShared Decimal @db.Decimal(10, 2)
  capacity    Int     @default(10)

  /// Apagar el horario deja de generar salidas nuevas pero no toca las ya
  /// generadas: para sacar una salida puntual de circulacion se cancela el Trip.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Una ruta no puede tener dos veces la misma hora
  @@unique([routeId, departureTime])
}

model Trip {
  id          String     @id @default(uuid())
  route       Route      @relation(fields: [routeId], references: [id])
  routeId     String
  departureAt DateTime
  capacity    Int        @default(10)
  bookedSeats Int        @default(0)
  priceShared Decimal    @db.Decimal(10, 2)
  status      TripStatus @default(SCHEDULED)
  source      TripSource @default(SCHEDULED)
  bookings    Booking[]
  createdAt   DateTime   @default(now())
}

/// Una compra. Agrupa 1 tramo (ida) o 2 (ida y vuelta).
/// Concentra plata, estado y ciclo de vida: un round trip es un solo cobro,
/// asi que el pago cuelga de aca y no de cada tramo.
model Reservation {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  type        BookingType
  tripType    TripType      @default(ONE_WAY)
  passengers  Int
  totalAmount Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  heldUntil   DateTime?
  notes       String?
  /// Numero de vuelo: solo aplica a rutas que tocan el aeropuerto
  flightNumber  String?
  /// Hotel o direccion exacta de pickup/dropoff puerta a puerta
  pickupAddress String?
  /// Firma tipeada de la politica de cancelacion. La fecha la pone el
  /// servidor al crear la reserva, no el cliente, para que quede como
  /// respaldo confiable de cuando se acepto.
  agreementSignedName String?
  agreementSignedAt   DateTime?

  /// Enlace secreto de la reserva: con el se ve, se paga y se cancela sin
  /// sesion. Va en el correo y en la URL que recibe el cliente. Se guarda en
  /// claro porque protege los mismos datos que ya estan en esta fila.
  accessToken   String?  @unique
  /// Hecha sin sesion. No aparece en "Mi cuenta" aunque el email coincida:
  /// sin verificacion de email, registrarse con el correo de otro no debe
  /// dar acceso a sus viajes.
  bookedAsGuest Boolean  @default(false)
  /// Contacto de esta reserva. En invitados manda sobre el del usuario, asi
  /// una reserva sin sesion nunca pisa los datos de una cuenta existente.
  contactName   String?
  contactPhone  String?

  legs        Booking[]
  payment     Payment?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Un tramo: la ocupacion de asientos en UNA salida concreta.
/// El estado y el dinero viven en Reservation; aca solo va el asiento,
/// para que el conteo de capacidad siga siendo por viaje.
model Booking {
  id            String       @id @default(uuid())
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  trip          Trip         @relation(fields: [tripId], references: [id])
  tripId        String
  direction     LegDirection @default(OUTBOUND)
  passengers    Int
  amount        Decimal      @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())

  @@unique([reservationId, direction])
  @@index([tripId])
}

enum PaymentProvider {
  PAYPAL
  BAC_CREDOMATIC
}

/// Configuracion de un metodo de pago. Aca NO van secretos.
///
/// El client secret y las api keys viven en variables de entorno del servidor
/// y nunca pasan por el navegador ni por la base: un dump, un backup o un XSS
/// en el panel no deben poder llevarse las llaves del dinero. Lo que se guarda
/// aca es lo que el admin necesita cambiar sin redeploy, y el clientId, que en
/// PayPal es publico por diseno porque viaja en el SDK del navegador.
model PaymentMethodConfig {
  id       String          @id @default(uuid())
  provider PaymentProvider @unique

  /// Si esta apagado el metodo no se ofrece al cliente
  isEnabled Boolean @default(false)

  /// true = sandbox. Se separa del secreto para poder alternar sin redeploy.
  isSandbox Boolean @default(true)

  /// Identificador publico (clientId de PayPal). Nunca un secreto.
  publicKey String?

  /// Orden en que se muestran los metodos al cliente
  sortOrder Int @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Payment {
  id            String       @id @default(uuid())
  reservation   Reservation  @relation(fields: [reservationId], references: [id])
  reservationId String       @unique
  provider   String        @default("PAYPAL")
  /// Id de la transaccion capturada en el proveedor
  externalId String?
  /// Id de la orden creada antes de cobrar. Unico: evita capturar dos veces
  /// la misma orden si el cliente hace doble clic o el webhook llega repetido.
  orderId    String?       @unique
  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("USD")
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
}