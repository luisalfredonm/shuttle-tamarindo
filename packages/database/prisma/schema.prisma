generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  DRIVER
}

enum TripStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TripSource {
  /// Horario fijo cargado por el admin: elegible para compartido
  SCHEDULED
  /// Creado al vuelo para un privado a hora libre: no debe listarse
  /// como opcion de compartido, es un vehiculo exclusivo de esa reserva
  ON_DEMAND
}

enum BookingType {
  SHARED
  PRIVATE
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum LegDirection {
  OUTBOUND
  RETURN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  phone        String?
  password     String        @default("")
  role         Role          @default(CUSTOMER)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Route {
  id           String   @id @default(uuid())
  slug         String   @unique
  origin       String
  destination  String
  durationMin  Int
  distanceKm   Int
  imageUrl     String?
  /// Privado va en un vehiculo exclusivo a la hora que el cliente elija, asi
  /// que no tiene sentido por Trip: es un precio fijo por ruta.
  pricePrivate Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  trips        Trip[]
  createdAt    DateTime @default(now())
}

model Trip {
  id          String     @id @default(uuid())
  route       Route      @relation(fields: [routeId], references: [id])
  routeId     String
  departureAt DateTime
  capacity    Int        @default(10)
  bookedSeats Int        @default(0)
  priceShared Decimal    @db.Decimal(10, 2)
  status      TripStatus @default(SCHEDULED)
  source      TripSource @default(SCHEDULED)
  bookings    Booking[]
  createdAt   DateTime   @default(now())
}

/// Una compra. Agrupa 1 tramo (ida) o 2 (ida y vuelta).
/// Concentra plata, estado y ciclo de vida: un round trip es un solo cobro,
/// asi que el pago cuelga de aca y no de cada tramo.
model Reservation {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  type        BookingType
  tripType    TripType      @default(ONE_WAY)
  passengers  Int
  totalAmount Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  heldUntil   DateTime?
  notes       String?
  /// Numero de vuelo: solo aplica a rutas que tocan el aeropuerto
  flightNumber  String?
  /// Hotel o direccion exacta de pickup/dropoff puerta a puerta
  pickupAddress String?
  /// Firma tipeada de la politica de cancelacion. La fecha la pone el
  /// servidor al crear la reserva, no el cliente, para que quede como
  /// respaldo confiable de cuando se acepto.
  agreementSignedName String?
  agreementSignedAt   DateTime?
  legs        Booking[]
  payment     Payment?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Un tramo: la ocupacion de asientos en UNA salida concreta.
/// El estado y el dinero viven en Reservation; aca solo va el asiento,
/// para que el conteo de capacidad siga siendo por viaje.
model Booking {
  id            String       @id @default(uuid())
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  trip          Trip         @relation(fields: [tripId], references: [id])
  tripId        String
  direction     LegDirection @default(OUTBOUND)
  passengers    Int
  amount        Decimal      @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())

  @@unique([reservationId, direction])
  @@index([tripId])
}

model Payment {
  id            String       @id @default(uuid())
  reservation   Reservation  @relation(fields: [reservationId], references: [id])
  reservationId String       @unique
  provider   String        @default("BAC_CREDOMATIC")
  externalId String?
  amount     Decimal       @db.Decimal(10, 2)
  currency   String        @default("USD")
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
}