# --- Base de datos -------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@localhost:5432/shuttle_tamarindo_dev"

# --- Sesion --------------------------------------------------------------
# Obligatorio. Sin esto la API no arranca: un secreto por defecto haria que
# cualquiera pudiera firmar un token de ADMIN valido.
JWT_SECRET="cambia-esto-por-un-secret-largo-y-aleatorio"

PORT=4000

# Dominios que pueden llamar a la API. Sin esto solo se aceptan los locales.
CORS_ORIGINS="https://retanaservices.com,https://www.retanaservices.com,https://admin.retanaservices.com"

# --- Pagos: PayPal -------------------------------------------------------
# El clientId tambien se carga en el panel (viaja al navegador en el SDK).
# El secret vive SOLO aca: no se guarda en la base ni se muestra en el panel.
PAYPAL_MODE=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook creado en el panel de PayPal. Sin el se rechazan los avisos.
PAYPAL_WEBHOOK_ID=

# --- Pagos: BAC Credomatic (pendiente de implementar) --------------------
BAC_API_KEY=
BAC_MERCHANT_ID=
BAC_API_URL=

# --- Correos (Resend) ----------------------------------------------------
# Sin un dominio verificado en resend.com/domains solo se puede enviar a la
# propia direccion de la cuenta: los clientes no reciben su confirmacion.
RESEND_API_KEY=
EMAIL_FROM="reservas@retanaservices.com"

# Sitio publico: a donde llevan los botones de los correos
SITE_URL="https://retanaservices.com"

# --- Anti-bots del checkout sin cuenta (Cloudflare Turnstile) -----------
# Opcional: mientras este vacio no se pide captcha para reservar como
# invitado. La clave del sitio va en la web (NEXT_PUBLIC_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# --- Fotos de las rutas (Vercel Blob) -----------------------------------
# Token del Blob store (Vercel > Storage > Blob > .env.local). Sin esto el
# panel no puede subir fotos y las rutas usan la foto general.
BLOB_READ_WRITE_TOKEN=

# --- Usuario admin inicial ----------------------------------------------
# Lo usa: npm run create:admin --workspace=apps/api -- "TuPasswordSegura"
ADMIN_NAME="Nombre del administrador"
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PHONE=""
